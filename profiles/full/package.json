{
  "name": "dsh-profile-math-full",
  "private": true,
  "description": "Full tier: what `node scripts/install.mjs --tier full` writes. Versions are pinned, not floated — a bare name can install the previous release and report success (docs/03-failure-log.md #7).",
  "dependencies": {
    "dsh-plugin-lean-math": "file:<repo>/packages/lean-math",
    "dsh-plugin-claim-verify": "file:<repo>/packages/claim-verify",
    "dsh-plugin-research-gate": "file:<repo>/packages/research-gate",
    "dsh-plugin-paper": "file:<repo>/packages/paper",
    "meow-memory": "0.32.4",
    "@nanmicoder/dsh-agent-teams": "0.1.28",
    "misakanet": "3.5.0"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-plugin-lean-math",
        "dsh-plugin-claim-verify",
        "dsh-plugin-research-gate",
        "dsh-plugin-paper",
        "meow-memory",
        "@nanmicoder/dsh-agent-teams",
        "misakanet"
      ],
      "patchReload": "live"
    }
  }
}
