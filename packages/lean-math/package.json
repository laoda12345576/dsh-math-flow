  "description": "Lean 4 bridge for dsh: verify proofs with the Lean kernel, inspect axioms, read goals, drive tactics, and search Mathlib premises.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./toolkit": "./lib/toolkit.js",
